# ==============================================================================
# ORALCARE Project - Root .gitignore
# Covers Root, Android App (SDC/), and Backend (Backend/)
# ==============================================================================

# ------------------------------------------------------------------------------
# Environment, Credentials & Secrets (CRITICAL)
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# Android & Gradle (SDC/)
# ------------------------------------------------------------------------------
# Gradle build outputs and caches
.gradle/
build/
**/build/
!src/**/build/

# Android signing keys & credentials
*.jks
*.keystore
release-key.properties
signing.properties

# Android Studio & SDK local properties
local.properties
.cxx/
**/.cxx/
.externalNativeBuild/
**/captures/

# Android build outputs
*.apk
*.ap_
*.aab
*.dex
*.class

# Navigation & Asset Wizard temp files
**/navEditor.xml
**/assetWizardSettings.xml

# ------------------------------------------------------------------------------
# Python & Backend (Backend/)
# ------------------------------------------------------------------------------
# Byte-compiled / optimized / DLL files
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# SQLite / Local Database files
*.db
*.sqlite
*.sqlite3
*.db-journal

# Local storage and test artifacts
storage_data/
**/storage_data/
temp_storage/
test_storage/

# Testing & Type checking caches
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# ------------------------------------------------------------------------------
# AI / ML Models, Weights & Datasets
# ------------------------------------------------------------------------------
*.joblib
*.pkl
*.pickle
*.pt
*.pth
*.onnx
*.tflite
*.h5
*.keras
*.safetensors
*.model
Backend/app/ai/*.joblib
Backend/app/ai/models/
Backend/app/ai/weights/

# Large Datasets & Archives
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar
SMART II Dataset*/
SMART II Dataset.zip
**/dataset/
**/datasets/

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# Android Studio / IntelliJ IDEA
.idea/
**/.idea/
*.iml
**/*.iml
out/
gen/

# VS Code
.vscode/
**/.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# Eclipse / NetBeans / Sublime Text
.project
.classpath
.settings/
*.sublime-project
*.sublime-workspace

# ------------------------------------------------------------------------------
# Operating System & Filesystem Junk
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# Logs & Diagnostic Dumps
# ------------------------------------------------------------------------------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

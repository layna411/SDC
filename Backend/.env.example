# OralCare Backend Environment Configuration
# Copy to .env and replace placeholder values before running in production.

APP_NAME=OralCare Clinical API
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=false

# MySQL 8+ Connection String
# Format: mysql+pymysql://<user>:<password>@<host>:<port>/<database>?charset=utf8mb4
DATABASE_URL=mysql+pymysql://oralcare_user:CHANGE_ME_STRONG_DB_PASSWORD@127.0.0.1:3306/oralcare_db?charset=utf8mb4

# JWT Authentication (Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))")
JWT_SECRET_KEY=CHANGE_ME_GENERATE_AT_LEAST_64_CHAR_RANDOM_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Account Lockout Policy
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# File Storage (Keep outside public web root)
STORAGE_ROOT=./storage_data
MAX_IMAGE_UPLOAD_MB=10
MAX_DOCUMENT_UPLOAD_MB=20

# CORS (Comma-separated list of allowed origins in production)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:8000

# AI Service Configuration
# Leave AI_MODEL_PATH empty unless a clinically validated oral-health model artifact is configured.
# When unset, the AI service performs OpenCV image quality validation and reports MODEL_UNAVAILABLE without fabricating findings.
AI_SERVICE_MODE=embedded
AI_SERVICE_URL=http://127.0.0.1:8001
AI_MODEL_NAME=unconfigured
AI_MODEL_VERSION=0.0.0
AI_MODEL_PATH=
AI_MIN_IMAGE_WIDTH=320
AI_MIN_IMAGE_HEIGHT=240

# Bootstrap Super Admin (Used only on initial empty database seed; rotate password immediately)
INITIAL_SUPER_ADMIN_USERNAME=superadmin
INITIAL_SUPER_ADMIN_EMAIL=superadmin@oralcare.local
INITIAL_SUPER_ADMIN_PASSWORD=CHANGE_ME_InitialSuperAdmin#2026

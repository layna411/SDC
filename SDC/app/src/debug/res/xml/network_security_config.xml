<?xml version="1.0" encoding="utf-8"?>
<!-- Debug-only network security config: allows LAN HTTP IPs (e.g. 172.x/192.168.x) during local development.
     Release builds use src/main/res/xml/network_security_config.xml which enforces HTTPS only. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
